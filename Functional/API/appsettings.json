{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "PostgreSQL",
    "ConnectionString": "Host=localhost;Port=5432;Database=templatedotnetbe;Username=postgres;Password=postgres",
    "EnableRetryOnFailure": false
  },
  "Jwt": {
    "Secret": "your-super-secret-key-min-32-chars-long!!",
    "ExpireHours": 24,
    "Issuer": "TemplateDotnetBE",
    "Audience": "TemplateDotnetBE"
  },
  "Admin": {
    "SecretKey": "your-admin-secret-key-change-this"
  },
  "RefreshToken": {
    "LifetimeDays": 7,
    "ReuseGracePeriodSeconds": 30
  },
  "Security": {
    "IdempotencyHmacKey": ""
  }
}
